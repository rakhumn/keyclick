{
  "name": "keyclick",
  "productName": "KeyClick",
  "version": "0.3.0",
  "description": "Mechanical keyboard sounds for any keyboard.",
  "private": true,
  "author": "Rakhman Muratbek",
  "repository": {
    "type": "git",
    "url": "https://github.com/rakhumn/keyclick"
  },
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "electron-updater": "^6.8.11",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "uiohook-napi@1.5.5": true
  },
  "build": {
    "appId": "com.rakhumn.keyclick",
    "productName": "KeyClick",
    "directories": {
      "output": "release"
    },
    "icon": "build/icon.png",
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "sounds",
        "to": "sounds"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "identity": null,
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "dmg": {
      "contents": [
        {
          "x": 160,
          "y": 220,
          "type": "file"
        },
        {
          "x": 480,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 320,
          "y": 400,
          "type": "file",
          "path": "build/Fix Gatekeeper Warning.command"
        }
      ]
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "afterPack": "build/afterPack.js",
    "publish": {
      "provider": "github",
      "owner": "rakhumn",
      "repo": "keyclick"
    }
  }
}
